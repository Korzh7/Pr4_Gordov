<Window x:Class="Pr4_Gordov.WPF.Views.ProductReviewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отзывы и оценка товара" Height="520" Width="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="ProductTitleText" Text="Название товара" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="ProductRatingText" Text="⭐ Средняя оценка: 0.0" FontSize="13" Foreground="#D97706" Margin="0,3,0,0"/>
        </StackPanel>

        <ListBox x:Name="ReviewsList" Grid.Row="1" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8" Margin="0,0,0,5">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding UserLogin}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0} / 5'}" FontWeight="Bold" Foreground="#D97706" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="Gray" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="AddReviewBorder" Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Оставить свой отзыв:" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Ваша оценка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RatingCombo" Width="90" Height="24">
                        <ComboBoxItem Content="⭐ 5" Tag="5" IsSelected="True"/>
                        <ComboBoxItem Content="⭐ 4" Tag="4"/>
                        <ComboBoxItem Content="⭐ 3" Tag="3"/>
                        <ComboBoxItem Content="⭐ 2" Tag="2"/>
                        <ComboBoxItem Content="⭐ 1" Tag="1"/>
                    </ComboBox>
                </StackPanel>
                <TextBox x:Name="CommentBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ReviewErrorText" Foreground="Red" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button Content="Опубликовать отзыв" Height="28" Padding="15,0" Click="SubmitReview_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>