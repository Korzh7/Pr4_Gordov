<Window x:Class="Pr4_Gordov.WPF.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина и оформление заказа" Height="550" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина покупок" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductTitle}" Width="*"/>
                <DataGridTextColumn Header="Цена за шт." Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding StockQuantity}" Width="80"/>
                <DataGridTemplateColumn Header="Количество" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="-" Width="25" Height="22" Click="DecreaseQty_Click" Margin="2,0"/>
                                <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <Button Content="+" Width="25" Height="22" Click="IncreaseQty_Click" Margin="2,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTemplateColumn Header="Действие" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Click="RemoveItem_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Способ получения:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="PickupRadio" Content="Самовывоз из ПВЗ" IsChecked="True" Checked="DeliveryRadio_Checked" Margin="0,0,15,0"/>
                        <RadioButton x:Name="CourierRadio" Content="Доставка курьером (от 600 ₽)" Checked="DeliveryRadio_Checked"/>
                    </StackPanel>

                    <StackPanel x:Name="PvzPanel">
                        <TextBlock Text="Выберите пункт выдачи (ПВЗ):"/>
                        <ComboBox x:Name="PvzCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="AddressPanel" Visibility="Collapsed">
                        <TextBlock Text="Адрес доставки:"/>
                        <TextBox x:Name="AddressBox" Height="26" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TotalCostText" Text="Итого: 0.00 ₽" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="OrderErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,5" Visibility="Collapsed"/>
                    <Button x:Name="CheckoutBtn" Content="Оформить заказ" Height="35" FontWeight="Bold" Click="CheckoutBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>