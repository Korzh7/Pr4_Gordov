<Window x:Class="Pr4_Gordov.WPF.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTitleText" Text="Добавление товара" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Название товара:"/>
                <TextBox x:Name="TitleBox" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Категория:"/>
                <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Цена (₽):"/>
                <TextBox x:Name="PriceBox" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Количество на складе:"/>
                <TextBox x:Name="StockBox" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Штук в упаковке (если требуется):"/>
                <TextBox x:Name="PackageBox" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Имя файла / путь к изображению:"/>
                <TextBox x:Name="ImageBox" Height="26" Margin="0,3,0,10"/>

                <TextBlock Text="Описание:"/>
                <TextBox x:Name="DescriptionBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3,0,10"/>

                <CheckBox x:Name="IsAvailableCheck" Content="Товар доступен для покупки" IsChecked="True" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Width="80" Height="28" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="100" Height="28" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>