<Window x:Class="Pr4_Gordov.WPF.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История заказов" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Мои заказы" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Сортировка по дате:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SortCombo" Width="150" SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Сначала новые" IsSelected="True"/>
                    <ComboBoxItem Content="Сначала старые"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionChanged="OrdersGrid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Способ доставки" Binding="{Binding DeliveryType}" Width="140"/>
                <DataGridTextColumn Header="Адрес / ПВЗ" Binding="{Binding DeliveryAddress}" Width="*"/>
                <DataGridTextColumn Header="Итого" Binding="{Binding TotalCost, StringFormat={}{0:N2} ₽}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Состав выбранного заказа:" FontWeight="Bold" Margin="0,5,0,5"/>

        <DataGrid x:Name="OrderItemsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductTitle}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Цена на момент покупки" Binding="{Binding UnitPrice, StringFormat={}{0:N2} ₽}" Width="160"/>
                <DataGridTextColumn Header="Итого" Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>