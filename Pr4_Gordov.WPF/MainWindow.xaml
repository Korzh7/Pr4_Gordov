<Window x:Class="Pr4_Gordov.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маркетплейс GMWOG - Каталог товаров" Height="700" Width="1020"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="GMWOG Маркетплейс" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserInfoText" Text="Гость" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                    <Button x:Name="FavoritesBtn" Content="Избранное" Height="28" Padding="10,0" Margin="0,0,8,0" Click="FavoritesBtn_Click"/>
                    <Button x:Name="CartBtn" Content="Корзина" Height="28" Padding="10,0" Margin="0,0,8,0" Click="CartBtn_Click"/>
                    <Button x:Name="OrdersBtn" Content="Мои заказы" Height="28" Padding="10,0" Margin="0,0,8,0" Click="OrdersBtn_Click"/>
                    <Button x:Name="AdminBtn" Content="Админка" Height="28" Padding="10,0" Margin="0,0,8,0" Visibility="Collapsed" Click="AdminBtn_Click"/>
                    <Button x:Name="AuthBtn" Content="Войти" Height="28" Padding="10,0" Click="AuthBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#F4F4F4" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Динамический поиск:"/>
                    <TextBox x:Name="SearchBox" Width="180" Height="24" TextChanged="DynamicFilter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Категория:"/>
                    <ComboBox x:Name="CategoryCombo" Width="170" Height="24" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DynamicFilter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Цена от:"/>
                    <TextBox x:Name="MinPriceBox" Width="70" Height="24" TextChanged="DynamicFilter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="до:"/>
                    <TextBox x:Name="MaxPriceBox" Width="70" Height="24" TextChanged="DynamicFilter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Сортировка:"/>
                    <ComboBox x:Name="SortCombo" Width="140" Height="24" SelectionChanged="DynamicFilter_Changed">
                        <ComboBoxItem Content="Сначала новые" IsSelected="True"/>
                        <ComboBoxItem Content="Сначала дешевые" Tag="price_asc"/>
                        <ComboBoxItem Content="Сначала дорогие" Tag="price_desc"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Сбросить фильтры" Height="24" Width="120" Margin="5,16,0,0" Click="ResetFilter_Click"/>
            </WrapPanel>
        </Border>

        <ListView x:Name="ProductsList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Background="White" Width="225" Margin="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding CategoryName}" Foreground="Gray" FontSize="11"/>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Height="40" Margin="0,2,0,4"/>

                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#444" TextWrapping="Wrap" Height="34" TextTrimming="CharacterEllipsis"/>

                            <Separator Margin="0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Rating, StringFormat=⭐ {0:0.0}}" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Content="Отзывы" Height="22" Width="68" Click="ProductReviews_Click"/>
                            </Grid>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding StockQuantity, StringFormat='Склад: {0} шт.'}" FontSize="11" Foreground="#047857"/>
                                <TextBlock Text="{Binding PackageInfo}" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="В корзину" Height="26" Margin="0,0,3,0" Click="AddToCart_Click"/>
                                <Button Grid.Column="1" Content="Купить" Height="26" Margin="3,0,0,0" Click="BuyDirect_Click"/>
                            </Grid>

                            <Button Content="❤ В избранное" Height="24" Click="AddToFavorites_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
